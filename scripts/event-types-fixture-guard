#!/usr/bin/env bash
#
# Event-types catalogue drift guard — run via `just lint` (lint-event-types).
#
# Two vendored copies of the published event-type catalogue live in this repo,
# and nothing tied either to its source (rules in `scripts/event-types-catalogue.mjs`):
#
# 1. `test/event-types-flat.json`, the TEST fixture. `test/service-info.json`
#    serves it as `"eventTypes": "file://test/event-types-flat.json"`, and the
#    business unit tests load it directly, so every suite that validates event
#    content validates against it. It must EQUAL the published catalogue.
#    It was two months stale (two types missing, a definition changed) when this
#    guard was written.
#
# 2. `components/business/src/types/event-types.default.json`, the RUNTIME
#    seed. A core validates against it until the catalogue download at startup
#    lands, and indefinitely when that download fails (it only logs a warning).
#    Every published entry must be in it unchanged; entries no longer published
#    are kept on purpose. It was last refreshed in October 2023 (23 published
#    types missing, 5 descriptions behind) when it joined this guard.
#
# The `version` field does NOT detect drift (the catalogue is republished under
# the same version), so the guard compares content, canonicalised (key order and
# whitespace ignored). Array order IS significant (`required`, `enum`):
# conservative, a reordering upstream is reported and costs one re-vendor.
#
# Refresh both with:  just update-event-types
#
# Network policy: the seed is always checked, against the published catalogue
# when it can be fetched and against the test fixture otherwise, so that part
# never depends on the network. The fixture itself needs the published file: the
# guard FAILS on drift, and on a 404/410 (the catalogue moved: the URL here is
# wrong, which is a real signal), and SKIPS that part when the catalogue cannot be
# reached or returns something that is not a catalogue. A github.io outage must
# not redden every build. Under GitHub Actions a skip is raised as a workflow
# warning so it is visible on the run, not buried in a green step.
set -uo pipefail
cd "$(dirname "$0")/.."

SCHEMA_URL=${EVENT_TYPES_URL:-https://pryv.github.io/event-types/flat.json}

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

SKIP_REASON=""
HTTP_CODE=$(curl -sS -L --connect-timeout 5 --max-time 30 -o "$TMP" -w '%{http_code}' "$SCHEMA_URL")
CURL_EXIT=$?
case "$HTTP_CODE" in
  404|410)
    echo "event-types catalogue guard: FAILED — $SCHEMA_URL answered $HTTP_CODE; the catalogue moved, update the URL" >&2
    exit 1
    ;;
esac
if [ "$CURL_EXIT" -ne 0 ] || { [ "$HTTP_CODE" != "000" ] && [ "$HTTP_CODE" -ge 400 ]; }; then
  SKIP_REASON="could not fetch $SCHEMA_URL (curl exit $CURL_EXIT, HTTP $HTTP_CODE)"
fi

node --input-type=module -e '
import { FIXTURE_PATH, SEED_PATH, canonical, loadCatalogue, applyToSeed, describeDifference } from "./scripts/event-types-catalogue.mjs";

const [publishedPath, url, fetchSkipReason] = process.argv.slice(1);
const warnSkip = (message) => {
  console.error(`event-types catalogue guard: SKIPPED the fixture check — ${message}`);
  if (process.env.GITHUB_ACTIONS) console.log(`::warning title=event-types catalogue guard skipped::${message}`);
};

let fixture, seed;
for (const [path, assign] of [[FIXTURE_PATH, (v) => { fixture = v; }], [SEED_PATH, (v) => { seed = v; }]]) {
  try {
    assign(loadCatalogue(path));
  } catch (err) {
    console.error(`event-types catalogue guard: cannot read ${path}: ${err.message}`);
    process.exit(1);
  }
}

let published = null;
if (fetchSkipReason) {
  warnSkip(fetchSkipReason);
} else {
  try {
    published = loadCatalogue(publishedPath);
  } catch (err) {
    // Unusable download: same class as an unreachable one (a captive portal or
    // an error page served with 200).
    warnSkip(`${url} did not return a valid catalogue (${err.message})`);
  }
}

let drift = false;
const report = (label, path, reference, diff, counts) => {
  drift = true;
  console.error(`event-types catalogue guard: DRIFT — ${label} ${path} is behind ${reference}`);
  for (const line of counts) console.error(`  ${line}`);
  if (diff.missing.length > 0) console.error(`  types published but absent: ${diff.missing.join(", ")}`);
  if (diff.extra.length > 0) console.error(`  types present but no longer published: ${diff.extra.join(", ")}`);
  if (diff.changed.length > 0) console.error(`  types whose definition differs: ${diff.changed.join(", ")}`);
  if (diff.sections.length > 0) console.error(`  other top-level sections that differ: ${diff.sections.join(", ")}`);
  console.error("  Re-vendor deliberately and run the suites against it:  just update-event-types");
  console.error("");
};
const typeCount = (c) => Object.keys(c.types).length;

// 1. The test fixture must equal the published catalogue (needs the network).
if (published != null && canonical(fixture) !== canonical(published)) {
  report("test fixture", FIXTURE_PATH, url, describeDifference(fixture, published), [
    `fixture:   ${typeCount(fixture)} types, version ${fixture.version}`,
    `published: ${typeCount(published)} types, version ${published.version}`
  ]);
}

// 2. The runtime seed must already contain every entry of the reference
// unchanged: applying it again changes nothing. The reference is the published
// catalogue, or the test fixture when that could not be fetched.
const reference = published ?? fixture;
const referenceLabel = published != null ? url : FIXTURE_PATH;
const expectedSeed = applyToSeed(seed, reference);
if (canonical(expectedSeed) !== canonical(seed)) {
  report("runtime seed", SEED_PATH, referenceLabel, { ...describeDifference(seed, expectedSeed), extra: [] }, [
    `seed:      ${typeCount(seed)} types, version ${seed.version}`,
    `reference: ${typeCount(reference)} types, version ${reference.version}`
  ]);
}

if (drift) process.exit(1);
const legacy = Object.keys(seed.types).filter((t) => !(t in reference.types));
console.log(`event-types catalogue guard: OK against ${published != null ? "the published catalogue" : "the test fixture only"} (${typeCount(reference)} types, version ${reference.version}; runtime seed keeps ${legacy.length} legacy type(s)${legacy.length > 0 ? ": " + legacy.join(", ") : ""})`);
' "$TMP" "$SCHEMA_URL" "$SKIP_REASON"
