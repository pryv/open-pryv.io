/**
 * Ensure backloop.dev's certificate bundle exists and print its absolute path.
 *
 * The lib-js integration suite proxies lib-js over HTTPS on l.backloop.dev,
 * with the proxy's certificate coming from backloop.dev. When no backloop
 * secret is configured (as on CI, and on a fresh clone), backloop serves its
 * public self-signed leaf, which Node's built-in fetch (undici) rejects with
 * DEPTH_ZERO_SELF_SIGNED_CERT. Trusting the bundle via NODE_EXTRA_CA_CERTS on
 * the test process makes fetch accept the loopback proxy.
 *
 * NODE_EXTRA_CA_CERTS is read once at process start-up and the bundle is only
 * written when backloop resolves a certificate, so the test runner warms it
 * here and exports the printed path before spawning mocha.
 *
 * On success: prints the bundle's absolute path to stdout, exits 0.
 * On any failure (no network, package missing, ...): prints nothing, exits
 * non-zero, so the caller degrades to "no extra CA" rather than breaking
 * test runs that do not need it.
 */

const path = require('node:path');
const fs = require('node:fs');

function fail () { process.exit(1); }

let backloop, pkgDir;
try {
  backloop = require('backloop.dev');
  // main = src/index.js -> package root is two levels up from the resolved main
  pkgDir = path.resolve(path.dirname(require.resolve('backloop.dev')), '..');
} catch (e) {
  fail();
}

// Honour the same certs-dir override backloop itself reads.
const certsDir = process.env.BACKLOOP_DEV_CERTS_DIR || path.join(pkgDir, 'certs');

// Where the bundle lands depends on the backloop version AND on which
// certificate was resolved: 5.2.0 caches the secret-gated and the public,
// self-signed material in separate subdirectories (`private/` and `public/`),
// while older versions wrote a single flat file. When no secret is configured
// (CI, a fresh clone), backloop provisions ONLY `public/`, so that path must
// be a candidate or the warm finds nothing and the caller degrades to "no
// extra CA", which is what left the lib-js suite failing on
// `self-signed certificate`. Resolved AFTER provisioning below, because none of
// these paths exist until backloop has written the certificate.
const BUNDLE_CANDIDATES = [
  path.join(certsDir, 'private', 'backloop.dev-bundle.crt'),
  path.join(certsDir, 'public', 'backloop.dev-bundle.crt'),
  path.join(certsDir, 'backloop.dev-bundle.crt')
];

// Choose the bundle that actually matches the certificate backloop just
// resolved (and the proxy will serve), not merely the first that exists. Both
// dirs can be present at once: a machine that once had a secret keeps a
// `private/` bundle, and after the secret is removed backloop serves the public
// cert while the stale `private/` bundle still sits on disk. Trusting that
// stale bundle would silently fail the suite on `self-signed certificate`.
// `httpsOptionsAsync` hands back the resolved `{ cert, ca }`, and each bundle
// file is `cert + '\n' + ca` (see backloop's check.js), so the right one is the
// candidate whose contents carry the resolved leaf cert. Existence order
// (private, public, flat) is only a fallback when the resolved options carry no
// cert to match against.
function pickBundle (resolved) {
  const existing = BUNDLE_CANDIDATES.filter((p) => fs.existsSync(p));
  if (existing.length === 0) return null;
  const leaf = resolved && typeof resolved.cert === 'string' ? resolved.cert.trim() : null;
  if (leaf) {
    const matched = existing.find((p) => {
      try {
        return fs.readFileSync(p, 'utf8').includes(leaf);
      } catch (e) {
        return false;
      }
    });
    if (matched != null) return matched;
  }
  return existing[0];
}

// backloop prints its provisioning notices to stdout; the caller captures our
// stdout as the bundle path, so route everything backloop writes to stderr and
// keep stdout for the path alone. Restore before printing it.
const realStdoutWrite = process.stdout.write.bind(process.stdout);
process.stdout.write = process.stderr.write.bind(process.stderr);

// interactive:false never prompts; a missing secret falls back to the public
// pack, which is exactly what we want to trust here.
backloop.httpsOptionsAsync({ interactive: false }, function (err, resolved) {
  process.stdout.write = realStdoutWrite;
  if (err) fail();
  const bundle = pickBundle(resolved);
  if (bundle == null) fail();
  process.stdout.write(bundle);
});
