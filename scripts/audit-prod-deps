#!/usr/bin/env bash
#
# Production-dependency vulnerability gate — run in CI (security-audit job).
#
# Fails the build on any HIGH or CRITICAL advisory affecting the RUNTIME
# dependency tree (`npm audit --omit=dev`), so a freshly-disclosed CVE on a
# shipped package breaks CI at build time instead of only surfacing later in
# the GitHub Dependabot tab. devDependencies (lint/test/build toolchain) are
# out of scope here: they are pruned by `--omit=dev` and never ship in the
# image, so their advisories are triaged separately, not gated.
#
# ALLOWLIST — advisories accepted after review (documented, not silent). Each
# entry MUST carry a reason and stay minimal; re-review when the dependency
# tree changes. An allowlisted advisory is still reported, just non-fatal.
set -euo pipefail
cd "$(dirname "$0")/.."

node <<'NODE'
const cp = require('child_process');

// GHSA id → why it is accepted. Keep this list SHORT and justified.
const ALLOWLIST = {
  // brace-expansion OOM DoS, reached only via email-templates → @ladjs/i18n →
  // multimatch → minimatch (locale-file glob matching).
  //
  // The installed version IS patched: the advisory names 5.0.8 as the only
  // fixed release, but the maintainer also backported the bound to the
  // maintenance lines (1.1.17, 2.1.3, 3.0.5), and the advisory range was never
  // narrowed to exclude them. Verified by running the expansion directly:
  // 2.0.2 expands a 13-group pattern to 53.3M characters, 1.1.17 stops at
  // 4.0M (EXPANSION_MAX_LENGTH). The root `overrides` entry pins that subtree
  // to ^1.1.17, which also satisfies minimatch@3.x's declared ^1.1.7 — the
  // resolution used to be flagged `invalid` by npm.
  //
  // Upgrading that subtree to 5.x is NOT an option and should not be retried:
  // brace-expansion 4+ exports `{ expand }` where 1.x–3.x export the function
  // itself, so minimatch@3.x fails with `TypeError: expand is not a function`
  // (verified). Drop this entry once the advisory range excludes the patched
  // maintenance lines, or once @ladjs/i18n/multimatch move off minimatch@3.x.
  'GHSA-mh99-v99m-4gvg': 'brace-expansion OOM; installed 1.1.18 carries the backported bound; advisory range not narrowed to the patched maintenance lines; 5.x export shape breaks minimatch@3.x',
  // js-yaml quadratic CPU in !!omap resolution. The fix (CVE-2026-59870) landed
  // only in the 5.x line and was NOT backported to 4.x, so it cannot be cleared
  // without a major bump of the foundational config parser (@pryv/boiler). The
  // vulnerability is a DoS reachable only by parsing attacker-controlled YAML;
  // js-yaml is used exclusively to load operator-controlled config files
  // (components/boiler/src/lib/nconf-yaml.ts → yaml.load of the on-disk config),
  // never request or user input, so the quadratic path is not reachable at
  // runtime. Drop this entry once boiler moves to js-yaml 5.x.
  'GHSA-5p4m-2wfm-xmqj': 'js-yaml !!omap quadratic CPU; reachable only via untrusted YAML, but js-yaml parses operator-controlled config files only (boiler nconf-yaml); fix is a non-backported 5.x major bump of the config parser',
};

let raw = '';
try {
  // npm audit exits non-zero when advisories exist; capture regardless.
  raw = cp.execSync('npm audit --omit=dev --json', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
} catch (e) {
  raw = e.stdout ? e.stdout.toString() : '';
}
if (!raw) { console.error('audit-prod-deps: could not run npm audit'); process.exit(2); }

const report = JSON.parse(raw);
const vulns = report.vulnerabilities || {};

// A package's `via` entries are either advisory objects (with a GHSA url) or
// strings naming another vulnerable package it depends on. Resolve the full
// set of root-cause GHSAs by following the string references transitively.
function rootGhsas(name, seen = new Set()) {
  if (seen.has(name)) return [];
  seen.add(name);
  const v = vulns[name];
  if (!v) return [];
  const out = [];
  for (const x of v.via || []) {
    if (typeof x === 'object' && x.url) {
      const g = (x.url.match(/GHSA-[^/]+$/) || [])[0];
      if (g) out.push(g);
    } else if (typeof x === 'string') {
      out.push(...rootGhsas(x, seen));
    }
  }
  return out;
}

const gating = [];   // high/critical, not allowlisted → fail
const accepted = []; // high/critical, allowlisted → report only
for (const v of Object.values(vulns)) {
  if (!['high', 'critical'].includes(v.severity)) continue;
  const ghsas = [...new Set(rootGhsas(v.name))];
  const allowed = ghsas.length > 0 && ghsas.every((g) => ALLOWLIST[g]);
  (allowed ? accepted : gating).push({ name: v.name, severity: v.severity, ghsas });
}

for (const a of accepted) {
  console.log(`audit-prod-deps: ACCEPTED ${a.severity} ${a.name} [${a.ghsas.join(', ')}] — allowlisted`);
}
if (gating.length) {
  console.error('audit-prod-deps: FAILED — high/critical advisories on runtime dependencies:');
  for (const g of gating) console.error(`  ${g.severity}  ${g.name}  ${g.ghsas.join(', ')}`);
  console.error('\nFix: bump the package (npm audit fix), add an override, or — after review — allowlist the advisory in scripts/audit-prod-deps with a reason.');
  process.exit(1);
}
console.log(`audit-prod-deps: OK — no gating high/critical runtime advisories (${accepted.length} allowlisted).`);
NODE
