#!/usr/bin/env node

// Binary for nightly tasks setup: one storage-size pass (account.get
// storageUsed) over this core's accounts. The core runs the same pass on its
// own (account.storageUsed.intervalHours, default 24); this script is for an
// operator who turned that off and schedules it themselves.

const { getApplication } = require('api-server/src/application.ts');
const { getLogger } = require('@pryv/boiler');
const { computeStorageUsedForAllAccounts } = require('api-server/src/methods/helpers/storageUsedJob.ts');
let logger;

(async () => {
  // Construct application
  const app = getApplication();
  await app.initiate();
  logger = getLogger('nightly-tasks');

  // This bit is useful to trace down promise rejections that aren't caught.
  process.on('unhandledRejection', (reason, promise) => {
    logger.warn('Unhandled promise rejection:', promise, 'reason:', reason.stack || reason);
  });
  process.on('exit', function () {
    logger.info('Service stopped.');
  });
  process.on('SIGINT', () => {
    logger.warn('Received SIGINT. Exiting...');
    process.exit(2);
  });

  logger.info('Starting update of storage size');
  computeStorageUsedForAllAccounts(logger)
    .then((r) => {
      logger.info(`${r.updated} of ${r.accounts} users updated${r.failed > 0 ? `, ${r.failed} failed` : ''}.`);
      logger.info('Nightly tasks completed.');
      process.exit(r.failed > 0 ? 1 : 0);
    })
    .catch(e => {
      logger.error(e, e);
      process.exit(1);
    });
})();
