#!/bin/bash
set -e

# Sets up PostgreSQL (compiled from source, local to the repository) for server app(s).
# Fully self-contained, no system packages. Binaries live in bin-ext/, data in var-pryv/,
# like the other engines.
#
# Result:
#   bin-ext/postgresql/        compiled binaries (bin/, lib/, share/)
#   var-pryv/postgresql-data/  data directory (created by initdb)
#   var-pryv/postgresql-logs/  log files
#
# An install left by an older version of this script in var-pryv/postgresql-bin/ is not
# moved (its client tools load libpq from that absolute path): PostgreSQL is built again
# into bin-ext/postgresql/, then the old install is removed once no server runs from it
# (restart a running one with ./storages/engines/postgresql/scripts/start, then run this
# script again). The data directory is kept as is.

PG_VERSION=16.8

# working dir fix
SCRIPT_FOLDER=$(cd $(dirname "$0"); pwd)
cd $SCRIPT_FOLDER/

# --- Resolve VAR_PRYV_FOLDER ---

if [[ -z "$VAR_PRYV_FOLDER" ]]; then
  VAR_PRYV_FOLDER=$SCRIPT_FOLDER/../../../../var-pryv
fi
mkdir -p "$VAR_PRYV_FOLDER"
VAR_PRYV_FOLDER="$(cd "$VAR_PRYV_FOLDER" && pwd)"

REPO_ROOT=$(cd "$SCRIPT_FOLDER/../../../.." && pwd)
PG_INSTALL_DIR=$REPO_ROOT/bin-ext/postgresql
PG_OLD_INSTALL_DIR=$VAR_PRYV_FOLDER/postgresql-bin
PG_DATA_DIR=$VAR_PRYV_FOLDER/postgresql-data
PG_LOGS_DIR=$VAR_PRYV_FOLDER/postgresql-logs

mkdir -p "$PG_LOGS_DIR"

if [[ -x "$PG_OLD_INSTALL_DIR/bin/pg_ctl" && ! -x "$PG_INSTALL_DIR/bin/pg_ctl" ]]; then
  echo "PostgreSQL found at its previous place ($PG_OLD_INSTALL_DIR): building it again into $PG_INSTALL_DIR"
fi

echo ""
echo "Checking for PostgreSQL ($PG_INSTALL_DIR)..."

if [[ -x "$PG_INSTALL_DIR/bin/pg_ctl" ]]; then
  echo "...already installed ($($PG_INSTALL_DIR/bin/pg_ctl --version))"
else
  echo "...not found, building PostgreSQL $PG_VERSION from source"
  echo ""

  # --- Check build dependencies ---
  if [[ "$(uname)" == "Linux" ]]; then
    MISSING_DEPS=()
    for lib in libreadline-dev zlib1g-dev; do
      if ! dpkg -s "$lib" >/dev/null 2>&1; then
        MISSING_DEPS+=("$lib")
      fi
    done
    if [[ ${#MISSING_DEPS[@]} -gt 0 ]]; then
      echo "Installing build dependencies: ${MISSING_DEPS[*]}"
      sudo apt-get update -qq
      sudo apt-get install -y -qq "${MISSING_DEPS[@]}"
    fi
  fi
  # macOS: readline + zlib ship with Xcode Command Line Tools; nothing to install.

  # Portable CPU-count helper (Linux has nproc, macOS has sysctl)
  if command -v nproc >/dev/null 2>&1; then
    NCPU=$(nproc)
  else
    NCPU=$(sysctl -n hw.ncpu)
  fi

  # --- Download source ---
  BUILD_DIR=$(mktemp -d)
  trap "rm -rf $BUILD_DIR" EXIT

  SRC_URL="https://ftp.postgresql.org/pub/source/v${PG_VERSION}/postgresql-${PG_VERSION}.tar.bz2"
  echo "Downloading $SRC_URL ..."
  curl -fsSL -o "$BUILD_DIR/postgresql.tar.bz2" "$SRC_URL"

  echo "Extracting..."
  tar xjf "$BUILD_DIR/postgresql.tar.bz2" -C "$BUILD_DIR"

  # --- Compile ---
  cd "$BUILD_DIR/postgresql-${PG_VERSION}"
  echo "Configuring (prefix=$PG_INSTALL_DIR)..."

  # macOS 15.0 SDK marks strchrnul() as 15.4-only; PG 16.x uses it in
  # src/port/snprintf.c without a __builtin_available guard, which breaks
  # the build under -Werror=unguarded-availability-new. The symbol exists
  # in all shipping macOS 15.x runtimes — silence the availability check.
  CONFIGURE_CFLAGS=""
  if [[ "$(uname)" == "Darwin" ]]; then
    CONFIGURE_CFLAGS="-Wno-unguarded-availability-new"
  fi

  CFLAGS="$CONFIGURE_CFLAGS" ./configure \
    --prefix="$PG_INSTALL_DIR" \
    --without-icu \
    --without-ldap \
    --without-pam \
    --without-gssapi \
    --without-systemd \
    --quiet

  echo "Compiling ($NCPU cores)..."
  make -j"$NCPU" --quiet

  echo "Installing to $PG_INSTALL_DIR ..."
  make install --quiet

  cd "$SCRIPT_FOLDER"
  echo "Build complete."
fi

# --- Remove an install left at the previous place (var-pryv/postgresql-bin/) ---

if [[ -d "$PG_OLD_INSTALL_DIR" && -x "$PG_INSTALL_DIR/bin/pg_ctl" ]]; then
  if pgrep -f "^$PG_OLD_INSTALL_DIR/bin/postgres" >/dev/null 2>&1; then
    echo ""
    echo "A PostgreSQL server still runs from $PG_OLD_INSTALL_DIR: restart it from $PG_INSTALL_DIR"
    echo "($PG_OLD_INSTALL_DIR/bin/pg_ctl stop -D $PG_DATA_DIR, then ./storages/engines/postgresql/scripts/start),"
    echo "then run this script again to remove the old install."
  else
    rm -rf "$PG_OLD_INSTALL_DIR"
    echo "Removed the previous install ($PG_OLD_INSTALL_DIR)"
  fi
fi

# --- Initialize data directory ---

if [[ ! -d "$PG_DATA_DIR" ]]; then
  echo ""
  echo "Initializing data directory ($PG_DATA_DIR)..."
  "$PG_INSTALL_DIR/bin/initdb" \
    -D "$PG_DATA_DIR" \
    --auth=trust \
    --no-locale \
    --encoding=UTF8 \
    >/dev/null
  echo "Data directory initialized."
else
  echo "Data directory already exists ($PG_DATA_DIR)"
fi

# --- Configure for local dev ---
# Use a unix socket in the data dir (no TCP by default in dev)
# and set the port to the config default (5432)

if ! grep -q "^port = 5432" "$PG_DATA_DIR/postgresql.conf" 2>/dev/null; then
  cat >> "$PG_DATA_DIR/postgresql.conf" <<'PGCONF'

# --- Pryv dev settings ---
port = 5432
listen_addresses = '127.0.0.1'
log_destination = 'stderr'
logging_collector = on
log_directory = 'log'
# 14-worker scaling: 300 gives headroom for `MOCHA_PARALLEL=1` on
# boxes with ~16 cores (≈14 workers × 16 conns/worker = 224).
max_connections = 300
shared_buffers = 128MB
PGCONF
  echo "Appended dev settings to postgresql.conf"
else
  # A data dir set up by an older version of this script keeps its lower
  # max_connections (full test runs then fail with "too many clients"). The
  # last setting in postgresql.conf wins: append the current value when the
  # effective one is lower. Keep in sync with the block above.
  dev_max_connections=300
  current=$(grep -E '^[[:space:]]*max_connections[[:space:]]*=' "$PG_DATA_DIR/postgresql.conf" | tail -1 | sed -E 's/^[^=]*=[[:space:]]*([0-9]+).*/\1/')
  if [[ -n "$current" && ! "$current" =~ ^[0-9]+$ ]]; then
    echo "max_connections in postgresql.conf is not a plain number, left as is: check it is at least $dev_max_connections"
  elif [[ -z "$current" || "$current" -lt "$dev_max_connections" ]]; then
    echo "max_connections = $dev_max_connections  # raised by scripts/setup (was ${current:-the default})" >> "$PG_DATA_DIR/postgresql.conf"
    echo "Raised max_connections from ${current:-the default} to $dev_max_connections in postgresql.conf: restart PostgreSQL to apply"
  fi
fi

echo ""
echo "PostgreSQL setup complete."
echo ""
echo "To start PostgreSQL (creates 'pryv' role and 'pryv-node' database automatically):"
echo "    ./storages/engines/postgresql/scripts/start"
echo ""
