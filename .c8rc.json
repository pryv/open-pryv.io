{
  "src": ["."],
  "include": [
    "components/*/src/**/*.{js,ts}",
    "storages/**/*.{js,ts}"
  ],
  "exclude": [
    "**/test/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "external-ressources/**",
    "tools/**",
    "storages/test/**",
    "storages/engines/*/test/**",
    "storages/datastores/*/test/**"
  ],
  "temp-directory": "./.v8-coverage",
  "reports-dir": "./coverage",
  "reporter": ["html", "text-summary", "json"],
  "all": true
}
